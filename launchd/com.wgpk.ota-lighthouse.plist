<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Lighthouse inbox poll every 15 min on the Wyndham Mac mini: read-only HTTP to the lighthouse-reports@ inbox
     API (token ~/.config/wgpk/lighthouse_inbox_token), parse new XLSX into data/lighthouse.sqlite, and when a
     new snapshot arrived post the agent views to the cockpit (OTA_INGEST_TOKEN). No browser, no operator lock.
     Uninstall: launchctl bootout gui/$(id -u)/com.wgpk.ota-lighthouse -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.wgpk.ota-lighthouse</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/wyndham/wgpk-ota-insights/.venv/bin/python</string>
    <string>-m</string><string>ota.lighthouse_mail</string>
    <string>--db</string><string>/Users/wyndham/wgpk-ota-insights/data/lighthouse.sqlite</string>
    <string>--poll-inbox</string>
    <string>--push-cockpit</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/wyndham/wgpk-ota-insights/app</string>
  <key>StartInterval</key><integer>900</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/wyndham/wgpk-ota-insights/logs/lighthouse.log</string>
  <key>StandardErrorPath</key><string>/Users/wyndham/wgpk-ota-insights/logs/lighthouse.log</string>
</dict>
</plist>
