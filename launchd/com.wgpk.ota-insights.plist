<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Read-only OTA collection, once a day at 10:20 local (Asia/Bangkok, fallback 11:30), on the Wyndham Mac mini.
     Separate from com.wgpk.review-operator: different repo, different job, no shared code.
     It attaches to the operator's Chrome only while holding the operator's lock, and skips itself
     within 60 min of a review window. Uninstall: launchctl bootout gui/$(id -u)/com.wgpk.ota-insights -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.wgpk.ota-insights</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/wyndham/wgpk-ota-insights/.venv/bin/python</string>
    <string>-m</string><string>ota.run</string>
    <string>--once</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/wyndham/wgpk-ota-insights/app</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>WGPK_OTA_HOME</key><string>/Users/wyndham/wgpk-ota-insights</string>
    <key>WGPK_OPERATOR_LOCK</key><string>/Users/wyndham/wgpk-review-operator/operator.lock</string>
    <key>WGPK_OTA_AVOID</key><string>09:15,11:30,13:45,16:00,18:15,21:00</string>
  </dict>
  <key>StartCalendarInterval</key>
  <!-- The review operator runs at 09:15, 11:30, 13:45, 16:00, 18:15 and 21:00 (Review Desk schedule_times);
       with the 60-min guard only 10:15-10:30 and 22:00-08:15 are free.
       10:20: just after the 09:15 run has refreshed the OTA logins (Booking is signed in then).
       22:15: fallback when 10:20 did not finish, and a Medallia-only pass when 10:20 found Medallia signed
       out (its Okta challenge is only cleared by the operator's 11:30 run). Otherwise it exits at once. -->
  <array>
    <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>20</integer></dict>
    <dict><key>Hour</key><integer>22</integer><key>Minute</key><integer>15</integer></dict>
  </array>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/wyndham/wgpk-ota-insights/logs/ota.out.log</string>
  <key>StandardErrorPath</key><string>/Users/wyndham/wgpk-ota-insights/logs/ota.err.log</string>
</dict>
</plist>
